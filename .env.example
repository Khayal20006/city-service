# =====================================================================
#  Şəhər Xidmətləri — ətraf dəyişənlərin nümunəsi
# ---------------------------------------------------------------------
#  1) Bu faylı .env adı ilə surətini yarat:  cp .env.example .env
#  2) REAL dəyərləri .env-ə yazın (parollar, JWT_SECRET).
#  .env faylı .gitignore-da olduğu üçün heç vaxt Git-ə düşməz.
# =====================================================================

# --- PostgreSQL ---
DB_HOST=localhost            # Docker-də "db" olur
DB_PORT=5432
DB_NAME=sehir_xidmetleri
DB_USER=postgres
DB_PASSWORD=

# --- JWT ---
# HS256 üçün minimum 32 simvol (256 bit). Yaratma: openssl rand -base64 64
JWT_SECRET=
JWT_ISSUER=https://api.city.gov.az
JWT_EXPIRATION_MINUTES=180

# --- İlk admin hesabı (bootstrap; sonra parolu dəyişin) ---
BOOTSTRAP_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@city.gov.az
SEED_CATEGORIES=true

# --- Server & CORS ---
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173
# Yerləşdirmədə (production) saytın domenini yazın, məsələn:
# CORS_ORIGINS=https://sehir.example.com

# --- Fayl yükləmə ---
UPLOAD_DIR=./uploads